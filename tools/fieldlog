#!/usr/bin/env python3
"""Log heartbeats from the base WS to JSONL for range runs (F-02). Usage: fieldlog ws://base:8800/ws/ui out.jsonl"""
import asyncio, sys, json
import websockets
async def main(url, out):
    async with websockets.connect(url) as ws:
        await ws.send(json.dumps({"v":1,"t":"hello","from":"fieldlog","data":{"kind":"ui"}}))
        with open(out, "a") as f:
            async for msg in ws:
                f.write(msg + "\n"); f.flush()
asyncio.run(main(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else "fieldlog.jsonl"))
